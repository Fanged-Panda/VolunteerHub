PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# Frontend API base URL (used by Vite client)
VITE_API_URL=http://localhost:4000

# MySQL connection URL (recommended)
# Example: mysql://user:password@localhost:3306/volunteerhub
DATABASE_URL=

# Or set MySQL connection fields directly
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=volunteerhub
# Set true if your provider requires TLS
MYSQL_SSL=false

# Frontend URL used by backend CORS allowlist
# Example: https://your-frontend-domain.com
FRONTEND_URL=

# Comma-separated list of allowed frontend origins in production
# Example: CORS_ORIGIN=https://volunteerhub.example.com,https://www.volunteerhub.example.com
CORS_ORIGIN=

# Optional production-only bootstrap admin (created once if not present)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional: set to false to disable demo users/events even in development
ENABLE_DEV_SEED=true

# Option 1: Generic SMTP config for real verification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Option 2: Gmail shortcut (email + app password)
MAIL_USER=
MAIL_APP_PASS=

# Groq chatbot configuration
# Create key from https://console.groq.com/keys

# Optional model override (default: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant
